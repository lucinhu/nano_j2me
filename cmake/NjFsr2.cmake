# The default build is C-only and needs neither Vulkan nor an SDK download.
option(NJ_ENABLE_FSR2 "Enable the AMD FidelityFX FSR2 Vulkan backend" OFF)
set(NJ_FSR2_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.local-tools/debug-runs/fsr2-sdk/install" CACHE PATH
    "Prefix installed by tools/build_fsr2_sdk.py")
get_filename_component(_nj_fsr2_dir "${CMAKE_CURRENT_LIST_DIR}/../src/port/fsr2" ABSOLUTE)
if(NJ_ENABLE_FSR2)
  enable_language(CXX)
  if(NOT EXISTS "${NJ_FSR2_SDK_ROOT}/include/ffx_fsr2.h")
    message(FATAL_ERROR "FSR2 SDK unavailable. Run tools/build_fsr2_sdk.py or set NJ_FSR2_SDK_ROOT to its install prefix.")
  endif()
  # A local Khronos headers tree is sufficient when the platform ships a loader.
  find_path(Vulkan_INCLUDE_DIR vulkan/vulkan.h HINTS "${NJ_FSR2_SDK_ROOT}/include")
  find_package(Vulkan REQUIRED)
  # This prefix is explicitly selected for the target architecture. NDK CMake
  # reroots ordinary find_library searches under its sysroot.
  set(NJ_FSR2_SDK_LIBRARY "${NJ_FSR2_SDK_ROOT}/lib/libffx_fsr2_vk.a")
  if(NOT EXISTS "${NJ_FSR2_SDK_LIBRARY}")
    message(FATAL_ERROR "No ffx_fsr2_vk archive in ${NJ_FSR2_SDK_ROOT}/lib")
  endif()
  add_library(nj_fsr2_backend STATIC "${_nj_fsr2_dir}/nj_fsr2_vk.cpp")
  set_target_properties(nj_fsr2_backend PROPERTIES POSITION_INDEPENDENT_CODE ON)
  target_compile_features(nj_fsr2_backend PRIVATE cxx_std_17)
  if(ANDROID)
    target_compile_options(nj_fsr2_backend PRIVATE -fno-exceptions)
  endif()
  if(NOT MSVC)
    target_compile_definitions(nj_fsr2_backend PRIVATE FFX_GCC=1)
  endif()
  target_include_directories(nj_fsr2_backend SYSTEM PRIVATE "${NJ_FSR2_SDK_ROOT}/include")
  target_include_directories(nj_fsr2_backend PUBLIC "${_nj_fsr2_dir}")
  target_link_libraries(nj_fsr2_backend PUBLIC "${NJ_FSR2_SDK_LIBRARY}" Vulkan::Vulkan)
endif()

function(nj_enable_fsr2 target)
  if(NJ_ENABLE_FSR2)
    target_compile_definitions(${target} PUBLIC NJ_ENABLE_FSR2=1)
    target_link_libraries(${target} PRIVATE nj_fsr2_backend)
  else()
    target_sources(${target} PRIVATE "${_nj_fsr2_dir}/nj_fsr2_stub.c")
  endif()
endfunction()
