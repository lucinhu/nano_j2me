From a807173da913eb7b20a48d80742e7674969380a7 Mon Sep 17 00:00:00 2001
From: lucinhu <lucinhu@users.noreply.github.com>
Date: Mon, 23 Nov 2026 23:17:03 +0800
Subject: [PATCH] info: add nano_j2me

---
 dist/info/nano_j2me_libretro.info | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)
 create mode 100644 dist/info/nano_j2me_libretro.info

diff --git a/dist/info/nano_j2me_libretro.info b/dist/info/nano_j2me_libretro.info
new file mode 100644
index 0000000..e8ca96a
--- /dev/null
+++ b/dist/info/nano_j2me_libretro.info
@@ -0,0 +1,31 @@
+display_name = "Mobile - J2ME (nano_j2me)"
+authors = "nano_j2me contributors"
+supported_extensions = "jar"
+corename = "nano_j2me"
+manufacturer = "Sun Microsystems"
+categories = "Emulator"
+systemname = "J2ME"
+systemid = "j2me"
+database = "Mobile - J2ME"
+# MIT runtime code, separately licensed font data and built-in AMR numeric data.
+# Preserve all applicable MIT, OFL and Apache license/notice files in packages.
+license = "MIT|OFL-1.1|Apache-2.0"
+permissions = ""
+display_version = "0.5.41"
+supports_no_game = "false"
+# Manual states only; architecture/ABI/build dependent, with external resources omitted.
+savestate = "true"
+savestate_features = "basic"
+cheats = "true"
+input_descriptors = "true"
+memory_descriptors = "true"
+libretro_saves = "false"
+core_options = "true"
+core_options_version = "2.0"
+load_subsystem = "false"
+hw_render = "false"
+needs_fullpath = "true"
+disk_control = "false"
+is_experimental = "true"
+notes = "Local JAR MIDlet-1 loading; JAD files are not read. RMS and FileConnection saves are core-managed under <save directory>/nano_j2me/<normalized JAR stem>/. Manual save states are architecture/ABI/build dependent; decoded heap PCM and playback cursors are preserved, native playback handles/queues are cleared, and external files are not rewound. No rewind, runahead, netplay or determinism claim. MIT code, Apache-2.0 AMR data and OFL font notices accompany distribution."
+description = "A native C99 J2ME runtime for MIDP MIDlets, with handset profiles, keypad/pointer input and software video. No external JVM or BIOS is required. Loads local JAR content; JAD and network services are not supported by this core."
-- 
2.56.1

