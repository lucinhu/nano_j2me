# No SPIRAM: QEMU's esp32s3 PSRAM model does not answer IDF's chip-ID probe
# (espressif/qemu#129 - still open, and NOT fixed by esp-develop 20260417 as
# tested).  With SPIRAM on, IDF aborts at startup with "Failed to init external
# RAM".  With it off, IDF leaves 356 KiB of internal RAM rather than 133 KiB,
# because the PSRAM init itself is what consumes the difference.
#
# The code keeps the PSRAM path - heap_caps_aligned_alloc(MALLOC_CAP_SPIRAM)
# with an internal-RAM fallback - which is what a real board takes.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
