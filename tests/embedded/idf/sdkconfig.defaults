# No SPIRAM in the QEMU image.
#
# The code path is there and is what a real board uses: idf_alloc() asks for
# MALLOC_CAP_SPIRAM first and falls back to internal RAM.  QEMU's esp32s3
# machine has an ssi_psram device, but neither quad nor octal mode came up in
# testing ("PSRAM chip is not connected"), so this image is sized for the
# internal RAM that is actually available and proves the RUNTIME executes.
#
# On hardware the same source runs with CONFIG_SPIRAM=y and a much larger pool.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
