# ---------------------------------------------------------------- build output
build/
build-*/
cmake-build-*/
out/
*.o
*.a
*.so
*.dylib
*.elf
*.bin
*.hex
*.map
sdkconfig
sdkconfig.old
compile_commands.json

# ------------------------------------------------- generated test fixtures
# tests/fixtures/ is ~1 MB of regenerable data.  Rebuild it with:
#   python3 tests/gen_fixtures.py       (zip/inflate fixtures)
#   tools/make_hello_jar.sh             (the VM-core MIDlet fixture)
tests/fixtures/
!tests/fixtures/.gitkeep
tests/out/

# ------------------------------------------------- runtime user data
# RecordStore writes one file per store, named <rms_dir>/<store>.rms, and the
# default rms_dir is the working directory - so a test run used to drop
# demo.rms into the repository root.  These are the player's saves, not source:
# never commit them, and point --rms-dir somewhere disposable when developing.
*.rms
*.rms.tmp

# ------------------------------------------------------- editor / OS noise
*.swp
*~
.DS_Store
.vscode/
.idea/

# Third-party test games fetched by tools/fetch_test_games.sh
tests/games/
